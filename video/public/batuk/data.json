t": "WHO", "mulai": 48.84, "akhir": 49.24}, {"t": "Indonesia", "mulai": 49.54, "akhir": 49.96}, {"t": "nyumbang", "mulai": 50.02, "akhir": 50.3}, {"t": "10", "mulai": 50.38, "akhir": 50.8}, {"t": "persen", "mulai": 50.82, "akhir": 51.1}, {"t": "kasus", "mulai": 51.12, "akhir": 51.34}, {"t": "TBC", "mulai": 51.38, "akhir": 51.68}, {"t": "baru", "mulai": 51.72, "akhir": 51.88}, {"t": "dunia", "mulai": 51.92, "akhir": 52.2}, {"t": "tahun", "mulai": 52.28, "akhir": 52.52}, {"t": "2024", "mulai": 52.68, "akhir": 53.38}, {"t": "terbanyak", "mulai": 53.62, "akhir": 53.96}, {"t": "kedua", "mulai": 53.98, "akhir": 54.3}, {"t": "setelah", "mulai": 54.38, "akhir": 54.64}, {"t": "India", "mulai": 54.68, "akhir": 54.98}, {"t": "Simpan", "mulai": 55.34, "akhir": 55.6}, {"t": "video", "mulai": 55.66, "akhir": 55.9}, {"t": "ini", "mulai": 55.94, "akhir": 56.14}, {"t": "dan", "mulai": 56.38, "akhir": 56.54}, {"t": "follow", "mulai": 56.58, "akhir": 56.82}, {"t": "buat", "mulai": 56.88, "akhir": 57.04}, {"t": "fakta", "mulai": 57.12, "akhir": 57.4}, {"t": "AI", "mulai": 57.44, "akhir": 57.66}, {"t": "kesehatan", "mulai": 57.68, "akhir": 58.1}, {"t": "lainnya", "mulai": 58.14, "akhir": 58.44}], "kalimat": [{"mulai": 0.18, "akhir": 7.02, "teks": "Google ngelatih AI dengerin lebih dari 300 juta potongan suara, termasuk sekitar 100 juta suara batuk."}, {"mulai": 7.38, "akhir": 13.28, "teks": "Namanya HeAR, singkatan dari Health Acoustic Representations, buatan Google Research tahun 2024."}, {"mulai": 13.66, "akhir": 18.92, "teks": "Potongannya dua detik, diambil dari video YouTube publik yang ada suara batuk, napas, atau deham."}, {"mulai": 19.32, "akhir": 25.4, "teks": "HeAR itu foundation model, alias model dasar yang bisa dipakai peneliti buat bikin AI pendeteksi penyakit dari suara."}, {"mulai": 25.8, "akhir": 32.299, "teks": "Dari 33 tugas uji, misalnya ngenalin COVID dan kebiasaan merokok dari batuk, HeAR rata-rata dapet peringkat terbaik."}, {"mulai": 32.64, "akhir": 35.7, "teks": "Model yang dibangun dari HeAR juga butuh data latihan lebih sedikit."}, {"mulai": 36.06, "akhir": 42.16, "teks": "Salcit Technologies dari India pakai HeAR buat riset deteksi dini TBC dari suara batuk, lewat produk mereka, Swaasa."}, {"mulai": 42.5, "akhir": 48.12, "teks": "TBC bisa diobati, tapi tiap tahun jutaan kasus gak ketahuan, sering karena orang susah ke layanan kesehatan."}, {"mulai": 48.5, "akhir": 54.98, "teks": "Menurut WHO, Indonesia nyumbang 10 persen kasus TBC baru dunia tahun 2024, terbanyak kedua setelah India."}, {"mulai": 55.34, "akhir": 58.44, "teks": "Simpan video ini, dan follow buat fakta AI kesehatan lainnya."}]}