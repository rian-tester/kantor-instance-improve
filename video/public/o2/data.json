, "akhir": 49.798}, {"t": "empat", "mulai": 49.798, "akhir": 50.32}, {"t": "koma", "mulai": 50.34, "akhir": 50.54}, {"t": "lima", "mulai": 50.58, "akhir": 50.88}, {"t": "naikin", "mulai": 51.12, "akhir": 51.5}, {"t": "batasnya", "mulai": 51.54, "akhir": 51.96}, {"t": "jadi", "mulai": 52.02, "akhir": 52.18}, {"t": "lima", "mulai": 52.22, "akhir": 52.5}, {"t": "frame", "mulai": 52.6, "akhir": 52.76}, {"t": "AI", "mulai": 52.84, "akhir": 53.2}, {"t": "per", "mulai": 53.22, "akhir": 53.38}, {"t": "frame", "mulai": 53.4, "akhir": 53.6}, {"t": "asli", "mulai": 53.66, "akhir": 53.96}, {"t": "Simpan", "mulai": 54.4, "akhir": 54.76}, {"t": "buat", "mulai": 54.8, "akhir": 54.96}, {"t": "pas", "mulai": 54.98, "akhir": 55.12}, {"t": "ngatur", "mulai": 55.14, "akhir": 55.4}, {"t": "DLSS", "mulai": 55.44, "akhir": 56.16}, {"t": "dan", "mulai": 56.4, "akhir": 56.52}, {"t": "follow", "mulai": 56.62, "akhir": 56.88}, {"t": "buat", "mulai": 56.94, "akhir": 57.08}, {"t": "fakta", "mulai": 57.12, "akhir": 57.3}, {"t": "PC", "mulai": 57.36, "akhir": 57.6}, {"t": "berikutnya", "mulai": 57.62, "akhir": 58.2}], "kalimat": [{"mulai": 0.12, "akhir": 6.6, "teks": "Menurut NVIDIA, dengan DLSS empat, lima belas dari enam belas piksel di layar kamu dibikin AI."}, {"mulai": 7.06, "akhir": 11.32, "teks": "Piksel itu titik warna penyusun gambar, dan satu gambar utuh namanya frame."}, {"mulai": 11.72, "akhir": 15.16, "teks": "Tanpa DLSS, game render semua piksel di tiap frame."}, {"mulai": 15.52, "akhir": 20.4, "teks": "Dengan DLSS, game cuma render di resolusi lebih kecil, terus AI ngisi sisanya."}, {"mulai": 20.92, "akhir": 24.34, "teks": "NVIDIA nyebut tiga perempat piksel di frame itu diisi AI."}, {"mulai": 24.86, "akhir": 31.42, "teks": "Ada juga Multi Frame Generation, diumumin Januari dua ribu dua puluh lima khusus VGA RTX lima puluh."}, {"mulai": 31.84, "akhir": 35.4, "teks": "Fitur ini bikin sampai tiga frame AI tambahan per frame asli."}, {"mulai": 35.88, "akhir": 42.32, "teks": "Jadi dari empat frame, cuma satu yang di-render game, itu pun cuma seperempat pikselnya, atau satu dari enam belas."}, {"mulai": 42.7, "akhir": 47.32, "teks": "Kata NVIDIA, FPS atau jumlah frame per detik bisa naik sampai delapan kali."}, {"mulai": 47.7, "akhir": 53.96, "teks": "Maret dua ribu dua puluh enam, DLSS empat koma lima naikin batasnya jadi lima frame AI per frame asli."}, {"mulai": 54.4, "akhir": 58.2, "teks": "Simpan buat pas ngatur DLSS, dan follow buat fakta PC berikutnya."}]}