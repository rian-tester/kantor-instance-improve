}, {"t": "cuma", "mulai": 47.06, "akhir": 47.26}, {"t": "ada", "mulai": 47.34, "akhir": 47.46}, {"t": "seratus", "mulai": 48.0, "akhir": 48.214}, {"t": "dua", "mulai": 48.214, "akhir": 48.305}, {"t": "puluh", "mulai": 48.305, "akhir": 48.458}, {"t": "tiga", "mulai": 48.458, "akhir": 48.58}, {"t": "titik", "mulai": 48.62, "akhir": 48.98}, {"t": "Simpan", "mulai": 49.44, "akhir": 49.84}, {"t": "video", "mulai": 49.88, "akhir": 50.14}, {"t": "ini", "mulai": 50.22, "akhir": 50.38}, {"t": "buat", "mulai": 50.44, "akhir": 50.62}, {"t": "obrolan", "mulai": 50.68, "akhir": 51.06}, {"t": "soal", "mulai": 51.1, "akhir": 51.3}, {"t": "game", "mulai": 51.38, "akhir": 51.52}, {"t": "retro", "mulai": 51.56, "akhir": 51.94}, {"t": "dan", "mulai": 52.16, "akhir": 52.34}, {"t": "follow", "mulai": 52.38, "akhir": 52.7}, {"t": "buat", "mulai": 52.78, "akhir": 52.94}, {"t": "fakta", "mulai": 53.0, "akhir": 53.22}, {"t": "game", "mulai": 53.3, "akhir": 53.44}, {"t": "lainnya", "mulai": 53.48, "akhir": 53.94}], "kalimat": [{"mulai": 0.18, "akhir": 6.4, "teks": "Level dua ratus lima puluh enam di Pac-Man gak bisa diselesaiin, karena angkanya gak muat di satu byte."}, {"mulai": 6.84, "akhir": 11.58, "teks": "Pac-Man buatan Namco tahun seribu sembilan ratus delapan puluh pakai prosesor delapan bit."}, {"mulai": 12.04, "akhir": 16.84, "teks": "Satu byte itu delapan bit, dan angka terbesar yang muat dua ratus lima puluh lima."}, {"mulai": 17.3, "akhir": 23.38, "teks": "Levelnya dihitung dari nol, jadi level dua ratus lima puluh enam tersimpan sebagai dua ratus lima puluh lima."}, {"mulai": 23.82, "akhir": 28.18, "teks": "Pas gambar ikon buah di pojok kanan bawah, game nambahin satu ke angka itu."}, {"mulai": 28.62, "akhir": 31.54, "teks": "Hasilnya balik ke nol, ini namanya overflow."}, {"mulai": 31.98, "akhir": 37.42, "teks": "Akibatnya proses gambar buah jalan dua ratus lima puluh enam kali dan ikut gambar data acak."}, {"mulai": 37.88, "akhir": 41.72, "teks": "Separuh kanan layar jadi penuh huruf, angka, dan simbol acak."}, {"mulai": 42.18, "akhir": 45.94, "teks": "Buat lanjut level, Pac-Man harus makan dua ratus empat puluh empat titik."}, {"mulai": 46.36, "akhir": 48.98, "teks": "Di level ini cuma ada seratus dua puluh tiga titik."}, {"mulai": 49.44, "akhir": 53.94, "teks": "Simpan video ini buat obrolan soal game retro, dan follow buat fakta game lainnya."}]}