", "mulai": 48.219, "akhir": 48.41}, {"t": "selesai", "mulai": 48.448, "akhir": 48.888}, {"t": "Murch", "mulai": 49.27, "akhir": 49.499}, {"t": "juga", "mulai": 49.537, "akhir": 49.671}, {"t": "ngingetin", "mulai": 49.69, "akhir": 50.091}, {"t": "jangan", "mulai": 50.34, "akhir": 50.646}, {"t": "motong", "mulai": 50.703, "akhir": 51.123}, {"t": "tepat", "mulai": 51.181, "akhir": 51.544}, {"t": "di", "mulai": 51.582, "akhir": 51.696}, {"t": "frame", "mulai": 51.754, "akhir": 51.983}, {"t": "aktornya", "mulai": 52.04, "akhir": 52.403}, {"t": "lagi", "mulai": 52.423, "akhir": 52.595}, {"t": "kedip", "mulai": 52.614, "akhir": 52.938}, {"t": "rasanya", "mulai": 53.187, "akhir": 53.493}, {"t": "kayak", "mulai": 53.531, "akhir": 53.703}, {"t": "mata", "mulai": 53.722, "akhir": 53.894}, {"t": "kelilipan", "mulai": 53.932, "akhir": 54.486}, {"t": "Simpan", "mulai": 54.868, "akhir": 55.193}, {"t": "video", "mulai": 55.231, "akhir": 55.461}, {"t": "ini", "mulai": 55.518, "akhir": 55.69}, {"t": "buat", "mulai": 55.728, "akhir": 55.881}, {"t": "patokan", "mulai": 55.919, "akhir": 56.206}, {"t": "ngedit", "mulai": 56.225, "akhir": 56.493}, {"t": "klip", "mulai": 56.531, "akhir": 56.875}, {"t": "dan", "mulai": 56.97, "akhir": 57.122}, {"t": "follow", "mulai": 57.18, "akhir": 57.524}, {"t": "buat", "mulai": 57.582, "akhir": 57.734}, {"t": "fakta", "mulai": 57.773, "akhir": 58.002}, {"t": "video", "mulai": 58.04, "akhir": 58.25}, {"t": "lainnya", "mulai": 58.27, "akhir": 58.575}], "kalimat": [{"mulai": 0.134, "akhir": 6.468, "teks": "Editor film peraih Oscar, Walter Murch, nemuin potongan adegannya terus jatuh pas aktornya kedip."}, {"mulai": 6.85, "akhir": 11.245, "teks": "Waktu itu dia lagi ngedit film The Conversation di awal 1970-an."}, {"mulai": 11.627, "akhir": 17.751, "teks": "Dia nentuin titik potong pakai feeling, dan berkali-kali jaraknya cuma beberapa frame dari kedipan Gene Hackman."}, {"mulai": 18.133, "akhir": 24.401, "teks": "Lalu dia baca wawancara sutradara John Huston: potongan adegan itu kedipan di antara dua fokus perhatian."}, {"mulai": 24.783, "akhir": 30.458, "teks": "Dari situ Murch punya teori, kita kedip pas selesai satu pikiran dan pindah ke pikiran berikutnya."}, {"mulai": 30.84, "akhir": 36.974, "teks": "Jadi buat Murch, tiap potongan adegan itu kayak kedipan buat penonton, nutup satu pikiran dan buka yang baru."}, {"mulai": 37.356, "akhir": 42.725, "teks": "Tahun 2009, peneliti Jepang ngerekam kedipan 14 orang yang nonton Mr. Bean tanpa suara."}, {"mulai": 43.107, "akhir": 48.888, "teks": "Hasilnya, kedipan mereka sering barengan, di bagian yang gak butuh banyak perhatian, misalnya pas satu aksi selesai."}, {"mulai": 49.27, "akhir": 54.486, "teks": "Murch juga ngingetin, jangan motong tepat di frame aktornya lagi kedip, rasanya kayak mata kelilipan."}, {"mulai": 54.868, "akhir": 58.575, "teks": "Simpan video ini buat patokan ngedit klip, dan follow buat fakta video lainnya."}]}