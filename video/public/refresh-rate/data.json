  "kalimat": [
    {
      "mulai": 0.1,
      "akhir": 5.08,
      "teks": "Periksa pengaturan monitor seratus empat puluh empat hertz, apakah Windows masih di enam puluh hertz?"
    },
    {
      "mulai": 5.36,
      "akhir": 10.28,
      "teks": "Hertz menunjukkan berapa kali layar ganti gambar tiap detik, Windows menyebutnya refresh rate."
    },
    {
      "mulai": 10.56,
      "akhir": 16.6,
      "teks": "Di Windows sebelas, buka Start, Settings, System, Display, lalu Advanced display."
    },
    {
      "mulai": 16.88,
      "akhir": 20.76,
      "teks": "Di bagian Choose a refresh rate, pilih angka yang paling tinggi."
    },
    {
      "mulai": 21.04,
      "akhir": 24.64,
      "teks": "Periksa ulang pilihan pengaturan layar ini, cukup dengan satu klik."
    },
    {
      "mulai": 24.92,
      "akhir": 29.0,
      "teks": "Angka yang ada tanda bintangnya tidak mendukung resolusi yang sedang kamu pakai."
    },
    {
      "mulai": 29.28,
      "akhir": 33.9,
      "teks": "Pengaturan layar perlu sesuai kemampuan monitor yang dibeli, agar tidak terbatas pada enam puluh."
    },
    {
      "mulai": 34.18,
      "akhir": 37.7,
      "teks": "Setelah kamu cek pengaturan, monitor kamu aktif di berapa hertz?"
    }
