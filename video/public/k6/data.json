 "fokus", "mulai": 48.176, "akhir": 48.499}, {"t": "ke", "mulai": 48.535, "akhir": 48.607}, {"t": "ceritanya", "mulai": 48.642, "akhir": 49.073}, {"t": "Buat", "mulai": 49.432, "akhir": 49.611}, {"t": "kreator", "mulai": 49.647, "akhir": 50.024}, {"t": "artinya", "mulai": 50.266, "akhir": 50.66}, {"t": "motong", "mulai": 50.732, "akhir": 51.091}, {"t": "pas", "mulai": 51.127, "akhir": 51.288}, {"t": "ada", "mulai": 51.342, "akhir": 51.467}, {"t": "gerakan", "mulai": 51.503, "akhir": 51.88}, {"t": "bikin", "mulai": 52.077, "akhir": 52.364}, {"t": "sambungan", "mulai": 52.4, "akhir": 52.777}, {"t": "klip", "mulai": 52.813, "akhir": 53.01}, {"t": "lebih", "mulai": 53.064, "akhir": 53.315}, {"t": "susah", "mulai": 53.387, "akhir": 53.673}, {"t": "disadari", "mulai": 53.691, "akhir": 54.104}, {"t": "Simpan", "mulai": 54.463, "akhir": 54.732}, {"t": "video", "mulai": 54.768, "akhir": 54.983}, {"t": "ini", "mulai": 55.037, "akhir": 55.234}, {"t": "buat", "mulai": 55.288, "akhir": 55.467}, {"t": "bahan", "mulai": 55.503, "akhir": 55.682}, {"t": "latihan", "mulai": 55.7, "akhir": 56.005}, {"t": "motong", "mulai": 56.023, "akhir": 56.238}, {"t": "klip", "mulai": 56.274, "akhir": 56.454}, {"t": "dan", "mulai": 56.687, "akhir": 56.848}, {"t": "follow", "mulai": 56.884, "akhir": 57.171}, {"t": "buat", "mulai": 57.207, "akhir": 57.386}, {"t": "fakta", "mulai": 57.458, "akhir": 57.691}, {"t": "editing", "mulai": 57.799, "akhir": 58.104}, {"t": "lainnya", "mulai": 58.122, "akhir": 58.427}], "kalimat": [{"mulai": 0.099, "akhir": 5.686, "teks": "Penonton yang lagi sengaja nyari cut pun bisa ngelewatin sepertiga cut yang nyambung sama gerakan."}, {"mulai": 6.134, "akhir": 13.452, "teks": "Tim Smith dan John Henderson dari University of Edinburgh nyebut fenomena ini edit blindness, di riset mereka tahun 2008."}, {"mulai": 13.811, "akhir": 19.048, "teks": "Tujuh peserta nonton potongan lima menit dari tujuh film, termasuk Blade Runner dan Citizen Kane."}, {"mulai": 19.416, "akhir": 22.985, "teks": "Tugasnya cuma satu, pencet tombol tiap kali mereka lihat ada cut."}, {"mulai": 23.344, "akhir": 27.074, "teks": "Secara keseluruhan, 15,8 persen sambungan gak ketahuan."}, {"mulai": 27.514, "akhir": 30.976, "teks": "Cut yang pindah ke adegan lain cuma kelewat 9,4 persen."}, {"mulai": 31.334, "akhir": 35.693, "teks": "Cut yang pindah sudut kamera di adegan yang sama kelewat 25,1 persen."}, {"mulai": 36.123, "akhir": 41.325, "teks": "Paling tinggi match action, cut yang jatuh pas ada gerakan, kelewat 32,4 persen."}, {"mulai": 41.683, "akhir": 49.073, "teks": "Kedipan penonton yang barengan sama cut cuma sekitar 1 persen, jadi menurut peneliti, kebanyakan cut kelewat karena penonton fokus ke ceritanya."}, {"mulai": 49.432, "akhir": 54.104, "teks": "Buat kreator, artinya motong pas ada gerakan bikin sambungan klip lebih susah disadari."}, {"mulai": 54.463, "akhir": 58.427, "teks": "Simpan video ini buat bahan latihan motong klip, dan follow buat fakta editing lainnya."}]}