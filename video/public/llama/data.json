"ke", "mulai": 85.88, "akhir": 85.94}, {"t": "banyak", "mulai": 85.98, "akhir": 86.18}, {"t": "topik", "mulai": 86.2, "akhir": 86.46}, {"t": "dia", "mulai": 86.7, "akhir": 86.84}, {"t": "belajar", "mulai": 86.88, "akhir": 87.24}, {"t": "dari", "mulai": 87.28, "akhir": 87.42}, {"t": "teks", "mulai": 87.52, "akhir": 87.72}, {"t": "sebanyak", "mulai": 87.76, "akhir": 88.22}, {"t": "yang", "mulai": 88.26, "akhir": 88.36}, {"t": "gak", "mulai": 88.4, "akhir": 88.54}, {"t": "mungkin", "mulai": 88.6, "akhir": 88.92}, {"t": "dibaca", "mulai": 88.94, "akhir": 89.24}, {"t": "satu", "mulai": 89.28, "akhir": 89.46}, {"t": "orang", "mulai": 89.52, "akhir": 89.72}], "kalimat": [{"mulai": 0.1, "akhir": 5.76, "teks": "Llama 3, model AI dari Meta, dilatih pakai lebih dari 15 triliun token."}, {"mulai": 6.1, "akhir": 10.24, "teks": "Token itu potongan teks. Bisa satu kata utuh, bisa juga sepotong kata."}, {"mulai": 10.68, "akhir": 14.98, "teks": "Coba bayangin kamu baca satu token tiap detik, tanpa tidur, tanpa berhenti."}, {"mulai": 15.36, "akhir": 21.78, "teks": "Sehari kamu dapet 86.400 token. Setahun sekitar 31,5 juta."}, {"mulai": 22.3, "akhir": 27.4, "teks": "Buat ngabisin 15 triliun token, butuh sekitar 475 ribu tahun."}, {"mulai": 27.76, "akhir": 31.74, "teks": "Kalau mulai bacanya 475 ribu tahun lalu, baru selesai hari ini."}, {"mulai": 32.28, "akhir": 36.34, "teks": "Data segini juga tujuh kali lebih banyak dari data versi sebelumnya, Llama 2."}, {"mulai": 36.78, "akhir": 43.0, "teks": "Semuanya dikumpulin dari sumber yang terbuka buat umum, termasuk kode program yang jumlahnya empat kali lipat dari Llama 2."}, {"mulai": 43.48, "akhir": 47.92, "teks": "Lebih dari 5 persen isinya bukan bahasa Inggris, tapi dari lebih 30 bahasa lain."}, {"mulai": 48.38, "akhir": 53.94, "teks": "Sebelum dipakai, teksnya disaring dulu: yang kembar dibuang, yang gak pantas dibuang, terus kualitasnya dinilai."}, {"mulai": 54.4, "akhir": 60.56, "teks": "Penilai kualitas itu dilatih pakai data dari Llama 2, jadi AI versi lama ikut milihin bacaan buat versi barunya."}, {"mulai": 61.08, "akhir": 66.24, "teks": "Bacaan sebanyak itu diproses di dua klaster komputer, masing-masing isinya 24 ribu GPU."}, {"mulai": 66.72, "akhir": 72.82, "teks": "Parameter itu angka-angka di dalam AI yang disetel selama latihan, dan Llama 3 versi kecil punya 8 miliar."}, {"mulai": 73.32, "akhir": 78.44, "teks": "Menurut takaran yang biasa dipakai peneliti, model segitu cukup dilatih sekitar 200 miliar token."}, {"mulai": 78.92, "akhir": 84.0, "teks": "Meta ngasih sekitar 75 kali lipatnya, dan ternyata modelnya masih terus makin bagus."}, {"mulai": 84.48, "akhir": 89.72, "teks": "Karena itu AI bisa nyambung ke banyak topik: dia belajar dari teks sebanyak yang gak mungkin dibaca satu orang."}]}