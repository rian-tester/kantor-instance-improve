ai": 50.04, "akhir": 50.34}, {"t": "video", "mulai": 50.4, "akhir": 50.66}, {"t": "ini", "mulai": 50.72, "akhir": 50.9}, {"t": "buat", "mulai": 50.94, "akhir": 51.12}, {"t": "pas", "mulai": 51.14, "akhir": 51.3}, {"t": "milih", "mulai": 51.32, "akhir": 51.52}, {"t": "VGA", "mulai": 51.56, "akhir": 52.0}, {"t": "dan", "mulai": 52.28, "akhir": 52.4}, {"t": "follow", "mulai": 52.48, "akhir": 52.78}, {"t": "buat", "mulai": 52.84, "akhir": 53.0}, {"t": "fakta", "mulai": 53.06, "akhir": 53.28}, {"t": "PC", "mulai": 53.34, "akhir": 53.54}, {"t": "lainnya", "mulai": 53.58, "akhir": 54.02}], "kalimat": [{"mulai": 0.22, "akhir": 9.88, "teks": "RTX empat puluh sembilan puluh punya enam belas ribu tiga ratus delapan puluh empat CUDA core, sedangkan Ryzen sembilan tujuh puluh sembilan lima puluh X cuma enam belas core."}, {"mulai": 10.34, "akhir": 14.92, "teks": "Kalau dihitung, jumlah core di VGA itu seribu dua puluh empat kali lipat."}, {"mulai": 15.36, "akhir": 20.1, "teks": "CUDA core itu unit hitung di dalam GPU, chip utama di VGA NVIDIA."}, {"mulai": 20.52, "akhir": 23.72, "teks": "Tapi satu CUDA core gak sama dengan satu core CPU."}, {"mulai": 24.14, "akhir": 33.08, "teks": "Menurut NVIDIA, CPU dirancang buat ngerjain satu thread, atau urutan perintah, secepat mungkin, dan bisa jalanin beberapa puluh thread sekaligus."}, {"mulai": 33.54, "akhir": 38.4, "teks": "GPU dirancang buat jalanin ribuan thread barengan, walau tiap thread lebih lambat."}, {"mulai": 38.84, "akhir": 44.1, "teks": "Satu frame empat K isinya lebih dari delapan juta piksel, dan warna tiap piksel harus dihitung."}, {"mulai": 44.54, "akhir": 49.62, "teks": "Kerjaan sebanyak itu bisa dipecah jadi tugas kecil dan dikerjain ribuan core sekaligus."}, {"mulai": 50.04, "akhir": 54.02, "teks": "Simpan video ini buat pas milih VGA, dan follow buat fakta PC lainnya."}]}