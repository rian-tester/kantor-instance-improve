.82}, {"t": "gak", "mulai": 50.82, "akhir": 51.02}, {"t": "ada", "mulai": 51.1, "akhir": 51.28}, {"t": "sistem", "mulai": 51.32, "akhir": 51.58}, {"t": "internal", "mulai": 51.64, "akhir": 52.02}, {"t": "yang", "mulai": 52.08, "akhir": 52.18}, {"t": "diretas", "mulai": 52.22, "akhir": 52.66}, {"t": "Simpan", "mulai": 53.08, "akhir": 53.36}, {"t": "video", "mulai": 53.4, "akhir": 53.64}, {"t": "ini", "mulai": 53.7, "akhir": 53.92}, {"t": "buat", "mulai": 53.94, "akhir": 54.1}, {"t": "dikirim", "mulai": 54.12, "akhir": 54.48}, {"t": "ke", "mulai": 54.5, "akhir": 54.58}, {"t": "tim", "mulai": 54.64, "akhir": 54.76}, {"t": "keuangan", "mulai": 54.8, "akhir": 55.18}, {"t": "kantor", "mulai": 55.22, "akhir": 55.46}, {"t": "kamu", "mulai": 55.5, "akhir": 55.72}, {"t": "dan", "mulai": 55.98, "akhir": 56.14}, {"t": "follow", "mulai": 56.2, "akhir": 56.58}, {"t": "buat", "mulai": 56.62, "akhir": 56.86}, {"t": "kasus", "mulai": 56.9, "akhir": 57.24}, {"t": "AI", "mulai": 57.32, "akhir": 57.6}, {"t": "lainnya", "mulai": 57.64, "akhir": 57.98}], "kalimat": [{"mulai": 0.22, "akhir": 8.18, "teks": "Satu karyawan transfer sekitar 25 juta dolar setelah video call sama atasan dan rekan kerja yang ternyata deepfake."}, {"mulai": 8.54, "akhir": 14.6, "teks": "Kejadiannya di kantor Hong Kong milik Arup, firma teknik asal Inggris yang ikut ngerjain Sydney Opera House."}, {"mulai": 14.96, "akhir": 21.48, "teks": "Awalnya dia dapet pesan dari orang yang ngaku CFO, kepala keuangan perusahaan di Inggris, soal transaksi rahasia."}, {"mulai": 21.86, "akhir": 24.32, "teks": "Dia sempat curiga itu email penipuan atau phishing."}, {"mulai": 24.72, "akhir": 30.16, "teks": "Lalu di video call, orang-orang di layar kelihatan dan kedengeran persis kayak rekan kerja yang dia kenal."}, {"mulai": 30.52, "akhir": 33.86, "teks": "Polisi Hong Kong bilang, semua orang di panggilan itu palsu."}, {"mulai": 34.22, "akhir": 41.2, "teks": "Dia lalu ngirim 200 juta dolar Hong Kong, sekitar 25,6 juta dolar AS, lewat 15 transaksi."}, {"mulai": 41.54, "akhir": 44.46, "teks": "Penipuannya baru ketahuan waktu dia ngecek ke kantor pusat."}, {"mulai": 44.84, "akhir": 52.66, "teks": "Bulan Mei 2024, Arup ngonfirmasi ke CNN kalau suara dan gambar palsu dipakai, tapi gak ada sistem internal yang diretas."}, {"mulai": 53.08, "akhir": 57.98, "teks": "Simpan video ini buat dikirim ke tim keuangan kantor kamu, dan follow buat kasus AI lainnya."}]}