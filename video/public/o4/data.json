ai": 49.82, "akhir": 49.9}, {"t": "atas", "mulai": 49.98, "akhir": 50.28}, {"t": "decompress", "mulai": 50.42, "akhir": 50.84}, {"t": "audio", "mulai": 50.9, "akhir": 51.2}, {"t": "gak", "mulai": 51.24, "akhir": 51.34}, {"t": "jadi", "mulai": 51.38, "akhir": 51.54}, {"t": "masalah", "mulai": 51.58, "akhir": 52.18}, {"t": "Simpan", "mulai": 52.54, "akhir": 52.82}, {"t": "video", "mulai": 52.86, "akhir": 53.14}, {"t": "ini", "mulai": 53.2, "akhir": 53.36}, {"t": "buat", "mulai": 53.4, "akhir": 53.56}, {"t": "jawab", "mulai": 53.62, "akhir": 53.78}, {"t": "pertanyaan", "mulai": 53.82, "akhir": 54.3}, {"t": "soal", "mulai": 54.34, "akhir": 54.54}, {"t": "ukuran", "mulai": 54.6, "akhir": 54.84}, {"t": "game", "mulai": 54.88, "akhir": 55.0}, {"t": "PC", "mulai": 55.04, "akhir": 55.62}, {"t": "dan", "mulai": 55.68, "akhir": 55.84}, {"t": "follow", "mulai": 55.88, "akhir": 56.24}, {"t": "buat", "mulai": 56.28, "akhir": 56.48}, {"t": "fakta", "mulai": 56.52, "akhir": 56.74}, {"t": "game", "mulai": 56.8, "akhir": 56.92}, {"t": "lainnya", "mulai": 56.96, "akhir": 57.38}], "kalimat": [{"mulai": 0.1, "akhir": 7.26, "teks": "Titanfall versi PC ukurannya empat puluh delapan GB, dan tiga puluh lima GB di antaranya audio tanpa kompresi."}, {"mulai": 7.7, "akhir": 12.44, "teks": "Titanfall itu game tembak-tembakan multiplayer dari Respawn, rilis tahun dua ribu empat belas."}, {"mulai": 12.9, "akhir": 17.22, "teks": "Audio yang dikompres ukurannya kecil, tapi harus dibuka dulu sebelum diputar."}, {"mulai": 17.64, "akhir": 22.4, "teks": "Proses buka kompresi ini namanya decompress, dan di PC kerjaan ini dilakuin CPU."}, {"mulai": 22.82, "akhir": 29.18, "teks": "Menurut Richard Baker, lead engineer Respawn, PC dual-core bakal ngabisin sebagian besar satu core buat decompress audio."}, {"mulai": 29.54, "akhir": 32.74, "teks": "Padahal prosesor dua core masih masuk syarat minimum Titanfall."}, {"mulai": 33.22, "akhir": 38.24, "teks": "Jadi Respawn nyimpen audionya tanpa kompresi, biar tenaga CPU tetap dipakai buat jalanin game."}, {"mulai": 38.7, "akhir": 42.42, "teks": "Sisanya, sekitar tiga belas GB, isinya peta dan data visual."}, {"mulai": 42.8, "akhir": 47.64, "teks": "Versi Xbox One di bawah tujuh belas GB, karena konsolnya punya decoder audio bawaan."}, {"mulai": 48.04, "akhir": 52.18, "teks": "Kata Baker, di PC kelas menengah ke atas, decompress audio gak jadi masalah."}, {"mulai": 52.54, "akhir": 57.38, "teks": "Simpan video ini buat jawab pertanyaan soal ukuran game PC, dan follow buat fakta game lainnya."}]}