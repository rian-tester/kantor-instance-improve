": 48.317, "akhir": 48.576}, {"t": "ngetes", "mulai": 48.628, "akhir": 49.007}, {"t": "36", "mulai": 49.042, "akhir": 49.663}, {"t": "orang", "mulai": 49.732, "akhir": 50.008}, {"t": "pakai", "mulai": 50.043, "akhir": 50.284}, {"t": "24", "mulai": 50.353, "akhir": 50.94}, {"t": "potongan", "mulai": 51.009, "akhir": 51.303}, {"t": "film", "mulai": 51.32, "akhir": 51.527}, {"t": "dan", "mulai": 51.751, "akhir": 51.855}, {"t": "hasilnya", "mulai": 51.889, "akhir": 52.286}, {"t": "efek", "mulai": 52.476, "akhir": 52.718}, {"t": "semacam", "mulai": 52.734, "akhir": 53.063}, {"t": "ini", "mulai": 53.114, "akhir": 53.253}, {"t": "memang", "mulai": 53.391, "akhir": 53.702}, {"t": "ada", "mulai": 53.771, "akhir": 53.943}, {"t": "Simpan", "mulai": 54.349, "akhir": 54.625}, {"t": "video", "mulai": 54.66, "akhir": 54.884}, {"t": "ini", "mulai": 54.936, "akhir": 55.091}, {"t": "buat", "mulai": 55.126, "akhir": 55.333}, {"t": "bahan", "mulai": 55.367, "akhir": 55.592}, {"t": "ngedit", "mulai": 55.626, "akhir": 55.919}, {"t": "klip", "mulai": 55.954, "akhir": 56.109}, {"t": "berikutnya", "mulai": 56.144, "akhir": 56.523}, {"t": "dan", "mulai": 56.748, "akhir": 56.886}, {"t": "follow", "mulai": 56.92, "akhir": 57.179}, {"t": "buat", "mulai": 57.317, "akhir": 57.49}, {"t": "fakta", "mulai": 57.559, "akhir": 57.835}, {"t": "video", "mulai": 57.87, "akhir": 58.094}, {"t": "lainnya", "mulai": 58.129, "akhir": 58.422}], "kalimat": [{"mulai": 0.078, "akhir": 5.48, "teks": "Penonton pernah muji akting seorang aktor di tiga adegan, padahal wajahnya sama persis."}, {"mulai": 5.946, "akhir": 9.984, "teks": "Ini eksperimen sutradara Soviet, Lev Kuleshov, sekitar seratus tahun lalu."}, {"mulai": 10.407, "akhir": 14.239, "teks": "Dia ngambil close-up wajah datar aktor terkenal Rusia, Ivan Mozzhukhin."}, {"mulai": 14.593, "akhir": 20.332, "teks": "Wajah yang sama disambung ke tiga gambar berbeda: semangkuk sup, peti mati, dan anak kecil yang lagi main."}, {"mulai": 20.867, "akhir": 28.858, "teks": "Menurut catatan sutradara Vsevolod Pudovkin, penonton ngira aktornya lagi mikir berat di depan sup, sedih lihat peti mati, dan senyum lihat anak itu."}, {"mulai": 29.203, "akhir": 31.93, "teks": "Padahal, wajah di ketiga sambungan itu sama persis."}, {"mulai": 32.378, "akhir": 35.071, "teks": "Efek ini sekarang dikenal sebagai efek Kuleshov."}, {"mulai": 35.442, "akhir": 38.911, "teks": "Rekaman aslinya udah hilang, jadi peneliti nyoba ngulang eksperimennya."}, {"mulai": 39.256, "akhir": 46.177, "teks": "Tahun 1992, percobaan Prince dan Hensley gak nemu efek ini, kebanyakan peserta bilang wajahnya gak nunjukin emosi."}, {"mulai": 46.557, "akhir": 53.943, "teks": "Tahun 2016, tim Daniel Barratt ngetes 36 orang pakai 24 potongan film, dan hasilnya efek semacam ini memang ada."}, {"mulai": 54.349, "akhir": 58.422, "teks": "Simpan video ini buat bahan ngedit klip berikutnya, dan follow buat fakta video lainnya."}]}