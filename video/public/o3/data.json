.84}, {"t": "Pixar", "mulai": 49.88, "akhir": 50.36}, {"t": "cukup", "mulai": 50.42, "akhir": 50.76}, {"t": "buat", "mulai": 50.8, "akhir": 51.02}, {"t": "game", "mulai": 51.06, "akhir": 51.22}, {"t": "nampilin", "mulai": 51.26, "akhir": 51.68}, {"t": "lebih", "mulai": 51.72, "akhir": 52.02}, {"t": "dari", "mulai": 52.06, "akhir": 52.22}, {"t": "enam", "mulai": 52.28, "akhir": 52.46}, {"t": "juta", "mulai": 52.5, "akhir": 52.74}, {"t": "frame", "mulai": 52.78, "akhir": 53.08}, {"t": "Simpan", "mulai": 53.5, "akhir": 53.88}, {"t": "video", "mulai": 53.92, "akhir": 54.16}, {"t": "ini", "mulai": 54.22, "akhir": 54.42}, {"t": "buat", "mulai": 54.48, "akhir": 54.64}, {"t": "obrolan", "mulai": 54.7, "akhir": 55.04}, {"t": "soal", "mulai": 55.08, "akhir": 55.26}, {"t": "grafis", "mulai": 55.32, "akhir": 55.76}, {"t": "dan", "mulai": 56.06, "akhir": 56.22}, {"t": "follow", "mulai": 56.28, "akhir": 56.58}, {"t": "buat", "mulai": 56.62, "akhir": 56.78}, {"t": "fakta", "mulai": 56.82, "akhir": 57.06}, {"t": "PC", "mulai": 57.1, "akhir": 57.3}, {"t": "lainnya", "mulai": 57.34, "akhir": 57.78}], "kalimat": [{"mulai": 0.1, "akhir": 10.18, "teks": "Pixar butuh dua puluh sembilan jam buat render satu frame Monsters University, padahal satu frame game enam puluh fps cuma dapet enam belas koma tujuh milidetik."}, {"mulai": 10.6, "akhir": 15.18, "teks": "Frame itu satu gambar diam, dan video itu rangkaian frame yang diputar cepat."}, {"mulai": 15.6, "akhir": 20.8, "teks": "Render artinya komputer ngitung warna, cahaya, dan bayangan sampai jadi gambar utuh."}, {"mulai": 21.24, "akhir": 25.0, "teks": "Angka itu disampaikan Sanjay Bakshi dari Pixar tahun dua ribu tiga belas."}, {"mulai": 25.42, "akhir": 29.28, "teks": "Pixar pakai dua ribu komputer dengan lebih dari dua puluh empat ribu core."}, {"mulai": 29.6, "akhir": 35.74, "teks": "Total render filmnya lebih dari seratus juta jam CPU, atau sekitar sepuluh ribu tahun di satu CPU."}, {"mulai": 36.16, "akhir": 41.36, "teks": "Salah satu alasannya global illumination, cara ngitung cahaya yang memantul berkali-kali."}, {"mulai": 41.78, "akhir": 47.42, "teks": "Enam puluh fps artinya enam puluh frame per detik, jadi satu frame cuma seperenam puluh detik."}, {"mulai": 47.84, "akhir": 53.08, "teks": "Kalau dihitung, waktu render satu frame Pixar cukup buat game nampilin lebih dari enam juta frame."}, {"mulai": 53.5, "akhir": 57.78, "teks": "Simpan video ini buat obrolan soal grafis, dan follow buat fakta PC lainnya."}]}