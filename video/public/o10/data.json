s", "mulai": 49.12, "akhir": 49.56}, {"t": "kali", "mulai": 49.6, "akhir": 49.76}, {"t": "lebih", "mulai": 49.8, "akhir": 49.96}, {"t": "cepat", "mulai": 50.0, "akhir": 50.32}, {"t": "Game", "mulai": 50.72, "akhir": 50.88}, {"t": "kayak", "mulai": 50.9, "akhir": 51.1}, {"t": "Starfield", "mulai": 51.16, "akhir": 51.72}, {"t": "bahkan", "mulai": 51.76, "akhir": 52.06}, {"t": "nulis", "mulai": 52.08, "akhir": 52.3}, {"t": "SSD", "mulai": 52.42, "akhir": 52.74}, {"t": "sebagai", "mulai": 52.78, "akhir": 53.06}, {"t": "syarat", "mulai": 53.08, "akhir": 53.3}, {"t": "minimum", "mulai": 53.34, "akhir": 53.84}, {"t": "Simpan", "mulai": 54.24, "akhir": 54.66}, {"t": "buat", "mulai": 54.7, "akhir": 54.86}, {"t": "pas", "mulai": 54.88, "akhir": 55.02}, {"t": "upgrade", "mulai": 55.08, "akhir": 55.34}, {"t": "penyimpanan", "mulai": 55.36, "akhir": 55.94}, {"t": "dan", "mulai": 56.12, "akhir": 56.24}, {"t": "follow", "mulai": 56.32, "akhir": 56.64}, {"t": "buat", "mulai": 56.68, "akhir": 56.86}, {"t": "fakta", "mulai": 56.9, "akhir": 57.08}, {"t": "PC", "mulai": 57.14, "akhir": 57.34}, {"t": "berikutnya", "mulai": 57.36, "akhir": 57.86}], "kalimat": [{"mulai": 0.18, "akhir": 7.4, "teks": "Harddisk muterin piringannya tujuh ribu dua ratus kali per menit, tapi tetap kalah cepat dari SSD yang gak punya bagian gerak."}, {"mulai": 7.76, "akhir": 14.1, "teks": "Di dalam harddisk atau HDD ada piringan magnetik, lengan pembawa kepala baca, dan motor pemutar."}, {"mulai": 14.48, "akhir": 20.6, "teks": "RPM itu putaran per menit, jadi tujuh ribu dua ratus RPM berarti seratus dua puluh putaran per detik."}, {"mulai": 21.0, "akhir": 27.62, "teks": "Tiap game minta data, lengannya harus geser ke jalur yang tepat, rata-rata sekitar sembilan milidetik di HDD desktop."}, {"mulai": 28.02, "akhir": 30.18, "teks": "Satu milidetik itu seperseribu detik."}, {"mulai": 30.56, "akhir": 35.52, "teks": "Terus kepala baca nunggu datanya lewat di bawahnya, rata-rata empat koma enam belas milidetik."}, {"mulai": 35.88, "akhir": 39.76, "teks": "Kalau datanya kepencar, proses geser dan nunggu ini kejadian berkali-kali."}, {"mulai": 40.12, "akhir": 44.0, "teks": "SSD nyimpen data di chip memori flash, mirip flashdisk ukuran besar."}, {"mulai": 44.38, "akhir": 50.32, "teks": "SSD rata-rata cuma butuh sekitar nol koma satu milidetik, kalau dihitung lebih dari seratus kali lebih cepat."}, {"mulai": 50.72, "akhir": 53.84, "teks": "Game kayak Starfield bahkan nulis SSD sebagai syarat minimum."}, {"mulai": 54.24, "akhir": 57.86, "teks": "Simpan buat pas upgrade penyimpanan, dan follow buat fakta PC berikutnya."}]}