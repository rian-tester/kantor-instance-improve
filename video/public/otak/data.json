"akhir": 50.12}, {"t": "lain", "mulai": 50.16, "akhir": 50.44}, {"t": "hasilnya", "mulai": 50.5, "akhir": 50.9}, {"t": "gak", "mulai": 50.94, "akhir": 51.1}, {"t": "bisa", "mulai": 51.14, "akhir": 51.36}, {"t": "dibaca", "mulai": 51.4, "akhir": 51.8}, {"t": "Relawan", "mulai": 52.18, "akhir": 52.48}, {"t": "juga", "mulai": 52.52, "akhir": 52.66}, {"t": "bisa", "mulai": 52.7, "akhir": 52.84}, {"t": "ngegagalin", "mulai": 52.88, "akhir": 53.42}, {"t": "decoder", "mulai": 53.46, "akhir": 53.94}, {"t": "dengan", "mulai": 54.0, "akhir": 54.2}, {"t": "sengaja", "mulai": 54.24, "akhir": 54.62}, {"t": "mikirin", "mulai": 54.66, "akhir": 55.06}, {"t": "hal", "mulai": 55.12, "akhir": 55.22}, {"t": "lain", "mulai": 55.22, "akhir": 55.58}, {"t": "Simpan", "mulai": 55.92, "akhir": 56.18}, {"t": "video", "mulai": 56.22, "akhir": 56.44}, {"t": "ini", "mulai": 56.5, "akhir": 56.8}, {"t": "dan", "mulai": 56.86, "akhir": 57.0}, {"t": "follow", "mulai": 57.04, "akhir": 57.32}, {"t": "buat", "mulai": 57.38, "akhir": 57.54}, {"t": "fakta", "mulai": 57.6, "akhir": 57.88}, {"t": "AI", "mulai": 57.96, "akhir": 58.16}, {"t": "lainnya", "mulai": 58.2, "akhir": 58.6}], "kalimat": [{"mulai": 0.14, "akhir": 6.04, "teks": "AI bisa nerjemahin aktivitas otak jadi kalimat, tanpa operasi atau alat yang ditanam di kepala."}, {"mulai": 6.48, "akhir": 12.14, "teks": "Ini riset tim University of Texas at Austin, terbit di jurnal Nature Neuroscience tahun 2023."}, {"mulai": 12.64, "akhir": 16.76, "teks": "Otaknya direkam pakai mesin fMRI, yang ngukur aliran darah di otak."}, {"mulai": 17.1, "akhir": 21.24, "teks": "Tiga relawan masing-masing tiduran 16 jam di mesin itu sambil dengerin podcast."}, {"mulai": 21.66, "akhir": 28.62, "teks": "Dari data itu, decoder AI belajar nyocokin pola otak dengan makna kalimat, dibantu GPT-1, pendahulu ChatGPT."}, {"mulai": 29.0, "akhir": 31.84, "teks": "Hasilnya bukan kata per kata, tapi inti maknanya."}, {"mulai": 32.259, "akhir": 37.2, "teks": "Misalnya, kalimat \"aku belum punya SIM\" keluar jadi \"dia bahkan belum mulai belajar nyetir\"."}, {"mulai": 37.58, "akhir": 41.32, "teks": "Sekitar setengah hasilnya punya makna yang dekat, kadang persis, sama aslinya."}, {"mulai": 41.74, "akhir": 46.28, "teks": "Decoder ini juga jalan waktu relawan ngebayangin cerita, atau nonton video tanpa suara."}, {"mulai": 46.7, "akhir": 51.8, "teks": "Tapi decoder cuma jalan buat orang yang ikut ngelatihnya, di orang lain hasilnya gak bisa dibaca."}, {"mulai": 52.18, "akhir": 55.58, "teks": "Relawan juga bisa ngegagalin decoder dengan sengaja mikirin hal lain."}, {"mulai": 55.92, "akhir": 58.6, "teks": "Simpan video ini, dan follow buat fakta AI lainnya."}]}