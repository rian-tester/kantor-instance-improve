}, {"t": "world", "mulai": 49.34, "akhir": 49.52}, {"t": "border", "mulai": 49.58, "akhir": 50.18}, {"t": "butuh", "mulai": 50.24, "akhir": 50.48}, {"t": "sekitar", "mulai": 50.52, "akhir": 50.88}, {"t": "delapan", "mulai": 50.94, "akhir": 51.38}, {"t": "puluh", "mulai": 51.42, "akhir": 51.58}, {"t": "hari", "mulai": 51.62, "akhir": 51.84}, {"t": "jalan", "mulai": 51.9, "akhir": 52.2}, {"t": "tanpa", "mulai": 52.24, "akhir": 52.46}, {"t": "berhenti", "mulai": 52.48, "akhir": 52.94}, {"t": "Simpan", "mulai": 53.44, "akhir": 53.7}, {"t": "video", "mulai": 53.74, "akhir": 53.96}, {"t": "ini", "mulai": 54.04, "akhir": 54.24}, {"t": "buat", "mulai": 54.28, "akhir": 54.44}, {"t": "bahan", "mulai": 54.48, "akhir": 54.66}, {"t": "obrolan", "mulai": 54.72, "akhir": 55.14}, {"t": "pas", "mulai": 55.18, "akhir": 55.32}, {"t": "mabar", "mulai": 55.34, "akhir": 55.56}, {"t": "Minecraft", "mulai": 55.6, "akhir": 56.26}, {"t": "dan", "mulai": 56.34, "akhir": 56.5}, {"t": "follow", "mulai": 56.56, "akhir": 56.9}, {"t": "buat", "mulai": 56.94, "akhir": 57.1}, {"t": "fakta", "mulai": 57.14, "akhir": 57.36}, {"t": "game", "mulai": 57.42, "akhir": 57.56}, {"t": "berikutnya", "mulai": 57.58, "akhir": 58.14}], "kalimat": [{"mulai": 0.12, "akhir": 5.12, "teks": "Kalau dihitung, peta Minecraft Java luasnya sekitar tujuh kali permukaan Bumi."}, {"mulai": 5.48, "akhir": 12.34, "teks": "Batas petanya disebut world border, dinding yang berdiri hampir tiga puluh juta blok dari titik tengah ke tiap arah."}, {"mulai": 12.76, "akhir": 15.48, "teks": "Jadi lebar petanya hampir enam puluh juta blok."}, {"mulai": 15.88, "akhir": 21.24, "teks": "Satu blok di Minecraft itu kubus satu meter, jadi lebarnya sekitar enam puluh ribu kilometer."}, {"mulai": 21.62, "akhir": 26.26, "teks": "Petanya berbentuk persegi, luasnya sekitar tiga koma enam miliar kilometer persegi."}, {"mulai": 26.64, "akhir": 31.74, "teks": "Permukaan Bumi, termasuk lautnya, luasnya sekitar lima ratus sepuluh juta kilometer persegi."}, {"mulai": 32.08, "akhir": 36.74, "teks": "Dibandingin sama daratannya aja, peta Minecraft sekitar dua puluh empat kali lebih luas."}, {"mulai": 37.12, "akhir": 43.48, "teks": "Dunia Minecraft gak dibikin sekaligus, tapi per potongan enam belas kali enam belas blok, namanya chunk, pas kamu mendekat."}, {"mulai": 43.96, "akhir": 47.98, "teks": "Jalan kaki biasa di Minecraft kecepatannya sekitar empat koma tiga blok per detik."}, {"mulai": 48.4, "akhir": 52.94, "teks": "Dari titik tengah ke world border, butuh sekitar delapan puluh hari jalan tanpa berhenti."}, {"mulai": 53.44, "akhir": 58.14, "teks": "Simpan video ini buat bahan obrolan pas mabar Minecraft, dan follow buat fakta game berikutnya."}]}